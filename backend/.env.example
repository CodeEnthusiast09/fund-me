# Server
PORT=8080
ENV=development

# Database (GORM + Postgres, no hardcoded connection strings)
DATABASE_URL=postgres://user:password@localhost:5432/fundlynest?sslmode=disable

# JWT
JWT_SECRET=
JWT_EXPIRY=24h

# CORS — explicit allow-list, never a wildcard
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (auth endpoints)
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fundlynest/campaigns
MAX_UPLOAD_SIZE_MB=5

# Payaza (server-side transaction verification, https://api.payaza.africa/live/)
# Verification auth uses the PUBLIC key (Payaza's Transaction Status Query
# API), not the secret key -- see internal/payaza/client.go.
PAYAZA_PUBLIC_KEY=
# Not currently used by any code path (kept for a future webhook signature
# check or other Payaza API call) -- optional.
PAYAZA_SECRET_KEY=
PAYAZA_API_BASE_URL=
